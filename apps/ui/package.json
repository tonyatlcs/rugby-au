{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @rugby-au/contracts build && next dev",
    "build": "pnpm --filter @rugby-au/contracts build && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --filter @rugby-au/contracts build && next typegen && tsc --noEmit",
    "test": "pnpm --filter @rugby-au/contracts build && vitest run",
    "test:watch": "pnpm --filter @rugby-au/contracts build && vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@rugby-au/contracts": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "clsx": "^2.1.1",
    "framer-motion": "^14.11.1",
    "http-errors": "^2.0.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/http-errors": "^2.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.0",
    "sass": "^1.108.1",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.28.0"
}
