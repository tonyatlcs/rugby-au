{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @rugby-au/contracts build && next dev",
    "build": "pnpm --filter @rugby-au/contracts build && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --filter @rugby-au/contracts build && next typegen && tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@rugby-au/contracts": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "clsx": "^2.1.1",
    "framer-motion": "^14.11.1",
    "http-errors": "^2.0.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-d3-tree": "^3.6.7",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/http-errors": "^2.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "sass": "^1.108.1",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.0"
}
