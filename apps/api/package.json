{
  "name": "api",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "pnpm --filter @rugby-au/contracts build && tsx watch src/server.ts | pino-pretty --colorize",
    "build": "pnpm --filter @rugby-au/contracts build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "start": "node dist/server.js",
    "typecheck": "pnpm --filter @rugby-au/contracts build && tsc -p tsconfig.eslint.json",
    "test": "pnpm --filter @rugby-au/contracts build && vitest run",
    "test:watch": "pnpm --filter @rugby-au/contracts build && vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "migrate:create": "migrate-mongo create",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:status": "migrate-mongo status"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@typegoose/typegoose": "~13.5.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "http-errors": "^2.0.1",
    "migrate-mongo": "^14.0.7",
    "mongodb": "^7.5.0",
    "mongoose": "~9.9.5",
    "typebox": "^1.4.6",
    "@rugby-au/contracts": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/http-errors": "^2.0.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
